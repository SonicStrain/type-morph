# Normalize line endings to LF in the repository; let Git handle OS-specific checkout conversion
* text=auto eol=lf

# Java source files — always LF
*.java text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.properties text eol=lf
*.imports text eol=lf

# Shell scripts — LF only (would break on CRLF)
*.sh text eol=lf

# Windows batch scripts — CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files — no line ending conversion
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.zip binary
